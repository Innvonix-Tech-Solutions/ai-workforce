log(null,`Input received: "${obj.substring(0,54)}…"`);
log(null,`Running the ${wf.name} workflow · ${wf.tasks.length} agents · ${wf.mode.toUpperCase()} mode`);
await sleep(rand(700,1100));
const grid=$('agrid');
wf.tasks.forEach((t,i)=>{const r=AGENT_ROLES[t.agent];const c=document.createElement('div');c.className='acard';c.id='ac-'+i;
c.innerHTML=`<div class="ae">${r.emoji}</div><div class="ar">${r.label}</div><div class="at">${t.task}</div><div class="as"><span class="sd"></span><span id="ast-${i}">Queued</span></div>`;
grid.appendChild(c);setTimeout(()=>c.classList.add('visible'),i*85);});
await sleep(600);
$('p1').classList.remove('active');$('p1').classList.add('done');$('p1').querySelector('.dot').textContent='✓';$('p2').classList.add('active');
const done=new Set();
async function runOne(i){const t=wf.tasks[i],r=AGENT_ROLES[t.agent],c=$('ac-'+i),st=$('ast-'+i);
c.classList.remove('visible');c.classList.add('running');st.textContent='Running…';
log(t.agent,t.task.substring(0,72));await sleep(rand(450,820));
for(const tool of r.tools){log(t.agent,tool+'( ) → '+toolOut(tool));await sleep(rand(450,820));}
c.classList.remove('running');c.classList.add('done');st.textContent='Done';log(t.agent,'result saved to shared context');done.add(i);}
if(wf.mode==='sequential'){for(let i=0;i<wf.tasks.length;i++)await runOne(i);}
else{while(done.size<wf.tasks.length){const ready=wf.tasks.map((t,i)=>i).filter(i=>!done.has(i)&&wf.tasks[i].deps.every(d=>done.has(d)));if(!ready.length)break;
if(ready.length>1)await Promise.all(ready.map(runOne));else await runOne(ready[0]);}}
$('p2').classList.remove('active');$('p2').classList.add('done');$('p2').querySelector('.dot').textContent='✓';$('p3').classList.add('active');$('p3').querySelector('.dot').textContent='✓';$('p3').classList.add('done');
await sleep(400);
const out=FINAL[e.wf]||'Review-ready output produced.';const hrsThis=rand(6,44);
$('resultArea').innerHTML=`<div class="result"><div class="rstats">
